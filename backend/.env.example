# ====================================
# Readless Backend Environment Config
# ====================================

# ===== 数据库配置 =====
# 注意：这里用的是容器内部端口5432，不是宿主机的5433
# Docker容器之间通过内部网络通信，使用服务名'db'和内部端口
DATABASE_URL=postgresql+asyncpg://readless:readless@db:5432/readless

# PostgreSQL密码（重要：请设置一个强密码！）
POSTGRES_PASSWORD=changeme_to_strong_password

# ===== AI服务配置 =====
# OpenAI API密钥（支持GPT-4、GPT-4 Turbo等）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# OpenAI API Base URL（可选，默认为官方API）
# 如使用Azure OpenAI或其他兼容服务，修改此项
# OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 模型配置（可选）
# OPENAI_MODEL=gpt-4-turbo-preview

# ===== 认证服务 =====
# Clerk认证密钥
# 获取地址: https://clerk.com/
CLERK_SECRET_KEY=sk_live_xxxxx

# Apple Sign In（用于Apple ID登录）
# 必须与你的macOS App Bundle ID一致
APPLE_BUNDLE_ID=com.readless.app

# JWT密钥（必须>=32位随机字符串）
JWT_SECRET_KEY=replace_with_a_very_strong_random_secret_at_least_32_chars

# 管理后台token（必须>=32位随机字符串）
ADMIN_TOKEN=replace_with_a_very_strong_admin_token_at_least_32_chars

# Resend 邮件服务（用于邮箱验证码登录）
# 获取地址: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# 发件人邮箱（需要在Resend中验证域名或邮箱）
RESEND_FROM_EMAIL=Readless <noreply@readless.cc>
# 验证码有效期（分钟）
EMAIL_LOGIN_CODE_EXPIRE_MINUTES=10
# 同一邮箱重发最小间隔（秒）
EMAIL_LOGIN_CODE_RESEND_INTERVAL_SECONDS=30

# ===== 对象存储（Cloudflare R2）=====
# Cloudflare R2配置
# 获取地址: https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://你的账户ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=你的AccessKeyId
R2_SECRET_KEY=你的SecretAccessKey
R2_BUCKET=readless

# ===== 语音合成服务 =====
# ElevenLabs API密钥
# 获取地址: https://elevenlabs.io/
ELEVENLABS_API_KEY=你的ElevenLabsKey

# ===== 域名配置 =====
DOMAIN=readless.cc

# ===== CORS配置 =====
# 生产环境建议限制具体域名，开发时可用 ["*"]
CORS_ORIGINS=["https://readless.cc","http://localhost:3000"]
