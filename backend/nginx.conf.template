# Nginx配置文件模板 - readless.cc
# 放置位置: /etc/nginx/sites-available/readless.cc

# 站点文件会被 include 到 nginx 的 http {} 中，这里可以直接声明限速 zone
limit_req_zone $binary_remote_addr zone=readless_search_retrieve:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=readless_search_answer:10m rate=30r/m;

server {
    listen 80;
    server_name readless.cc www.readless.cc;

    # Let's Encrypt验证路径
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 重定向到HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name readless.cc www.readless.cc;

    # SSL证书配置 (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/readless.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/readless.cc/privkey.pem;

    # SSL优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # 安全头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 日志
    access_log /var/log/nginx/readless.access.log;
    error_log /var/log/nginx/readless.error.log;

    # 文件上传大小限制（应用层原始文件限制为 10 MiB，预留 base64/JSON 开销）
    client_max_body_size 15M;
    client_body_buffer_size 128k;
    client_body_timeout 30s;
    keepalive_timeout 30s;
    send_timeout 30s;
    limit_req_status 429;

    # 超时配置（AI处理可能需要较长时间）
    proxy_connect_timeout 75s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    # 先在网关层为搜索接口吸收一部分突发请求，减少应用层和 LLM 压力
    location = /api/v1/search/retrieve {
        limit_req zone=readless_search_retrieve burst=30 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache 1;
        proxy_buffering off;
    }

    location = /api/v1/search/ {
        limit_req zone=readless_search_answer burst=10 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache 1;
        proxy_buffering off;
    }

    # API代理到本地FastAPI服务
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;

        # WebSocket支持（如果需要）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # 禁用缓存（API响应）
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache 1;
        proxy_buffering off;
    }

    # 健康检查端点（不记录日志）
    location /health {
        proxy_pass http://127.0.0.1:8001/health;
        access_log off;
    }

    # API文档（可选，生产环境建议禁用）
    location /docs {
        proxy_pass http://127.0.0.1:8001/docs;
    }

    location /redoc {
        proxy_pass http://127.0.0.1:8001/redoc;
    }

    # 静态文件缓存（如果有）
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:8001;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 防止访问敏感文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
